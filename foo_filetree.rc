    PUSHBUTTON      "Remove",IDC_FAV_REMOVE,243,48,50,14
    PUSHBUTTON      "Move up",IDC_FAV_UP,243,68,50,14
    PUSHBUTTON      "Move down",IDC_FAV_DOWN,243,84,50,14
