    CONTROL         "Draw a line between them",IDC_FAV_SEPARATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,85,189,208,10
    LTEXT           "Right-click a folder in the tree to add it or remove it.",IDC_STATIC,12,206,281,8
END

