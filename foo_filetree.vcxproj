  <PropertyGroup Label="UserMacros">
    <!-- The workspace SDK, not a vendored copy. See ../AGENTS.md. -->
    <SdkRoot>..\SDK-2026-09-17</SdkRoot>
    <!-- The SDK libs expose the /MT flavour as a separate configuration. build.bat builds them. -->
    <SdkLibConfiguration Condition="'$(Configuration)'=='Release'">Release-Static</SdkLibConfiguration>
    <SdkLibConfiguration Condition="'$(Configuration)'=='Debug'">Debug</SdkLibConfiguration>
    <!-- The SDK projects have no OutDir override for x64, so output lands in $(Platform)\$(Configuration).
         The Win32 flavour is unverified and is checked at M8. -->
    <SdkLibSubDir Condition="'$(Platform)'=='x64'">x64\$(SdkLibConfiguration)</SdkLibSubDir>
    <SdkLibSubDir Condition="'$(Platform)'=='Win32'">$(SdkLibConfiguration)</SdkLibSubDir>
    <!-- The Columns UI SDK project has no Release-Static configuration: our copy sets
         RuntimeLibrary explicitly, so its plain Release is already /MT. Its Debug is /MTd, which
         does NOT match this project's /MDd Debug - a Debug build will hit LNK2038. Debug is
         unused; revisit at M8 if it is ever needed.
         The project is named columns_ui-sdk-public but its TargetName is columns_ui_sdk, so the
         output is columns_ui_sdk.lib. -->
    <CuiLibConfiguration>$(Configuration)</CuiLibConfiguration>
    <CuiLibSubDir Condition="'$(Platform)'=='x64'">x64\$(CuiLibConfiguration)</CuiLibSubDir>
    <CuiLibSubDir Condition="'$(Platform)'=='Win32'">$(CuiLibConfiguration)</CuiLibSubDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetName>foo_filetree</TargetName>
    <OutDir>$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\obj\</IntDir>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- /W4-as-errors is for our code. SDK and Windows headers arrive through angle includes. -->
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(SdkRoot)\foobar2000;$(SdkRoot);..\wtl\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Mandatory for anything compiling SDK headers; without it release-only miscompiles. -->
      <AdditionalOptions>/d2notypeopt %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(SdkRoot)\pfc\$(SdkLibSubDir)\pfc.lib;$(SdkRoot)\foobar2000\SDK\$(SdkLibSubDir)\foobar2000_SDK.lib;$(SdkRoot)\foobar2000\helpers\$(SdkLibSubDir)\foobar2000_sdk_helpers.lib;$(SdkRoot)\libPPUI\$(SdkLibSubDir)\libPPUI.lib;$(SdkRoot)\foobar2000\foobar2000_component_client\$(SdkLibSubDir)\foobar2000_component_client.lib;$(SdkRoot)\columns_ui-sdk\$(CuiLibSubDir)\columns_ui_sdk.lib;$(SdkRoot)\foobar2000\shared\shared-$(Platform).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <!-- Matches the SDK's Debug configuration, which ships as /MDd. -->
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <PreprocessorDefinitions>_DEBUG;_WINDLL;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <!-- Static CRT: users need no redistributable. Pairs with the SDK's Release-Static libs. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <StringPooling>true</StringPooling>
      <!-- Keep frame pointers so crash stacks from users are walkable. -->
      <OmitFramePointers>false</OmitFramePointers>
      <FloatingPointModel>Fast</FloatingPointModel>
      <!-- windows.h min/max macros break std::max and std::clamp at the call site. -->
      <PreprocessorDefinitions>NDEBUG;_WINDLL;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
