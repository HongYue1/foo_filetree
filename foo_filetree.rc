// Folder Tree resources. Hand-written, not generated. Coordinates are dialog units.

#include "resource.h"
#include "winres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

// Preferences style profile (keep every tab consistent with this; see
// foobar2000-component-dev/references/preferences-pages.md):
//   sections : header + etched line, no group boxes, no bold
//   fields   : labels in a left column at x 12, 70 wide, colon after; fields at x 85
//   rhythm   : check boxes 14 DU apart, field rows 16 DU, 12 DU before a new section header
//   hints    : plain text under the field (x 85), units right of the field
//   columns  : one column 7..293; content indented 5
//   colours  : swatch button that opens the colour picker + hex edit

/////////////////////////////////////////////////////////////////////////////
// Preferences page: the tab strip and the area the tabs are placed in (never shown).

IDD_PREFERENCES DIALOGEX 0, 0, 300, 246
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_TABS,"SysTabControl32",WS_CLIPSIBLINGS | WS_TABSTOP,7,3,286,17
    LTEXT           "",IDC_PAGE_HOST,0,24,300,222,NOT WS_VISIBLE
END

// Tabs: child dialogs, 300 x 222, created once and shown one at a time.

IDD_TAB_GENERAL DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Playlists",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Temporary playlist:",IDC_STATIC,12,23,70,8
    EDITTEXT        IDC_TEMP_PLAYLIST,85,21,120,12,ES_AUTOHSCROLL
    LTEXT           "Filled by Play and by the default double click on a file.",IDC_STATIC,85,36,208,8
    CONTROL         "Include subfolders when sending a folder (hold Shift for the opposite)",IDC_RECURSIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,50,281,10

    LTEXT           "Panel",IDC_STATIC,7,72,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,82,286,1
    CONTROL         "Show the address bar (Ctrl+L types a path)",IDC_SHOW_ADDRESS_BAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,89,281,10
    LTEXT           "Filter box (Ctrl+F):",IDC_STATIC,12,105,70,8
    COMBOBOX        IDC_FILTER_BOX,85,103,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "On startup:",IDC_STATIC,12,121,70,8
    COMBOBOX        IDC_STARTUP,85,119,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_STARTUP_FOLDER,85,135,180,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_STARTUP_BROWSE,268,134,25,14
    CONTROL         "Update open folders when files change on disk",IDC_WATCH_CHANGES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,152,281,10

    LTEXT           "Drives",IDC_STATIC,7,170,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,180,286,1
    CONTROL         "Show these drives as roots in every Folder Tree panel:",IDC_DRIVES_LABEL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,186,281,10
END

IDD_TAB_DISPLAY DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Tree lines",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Style:",IDC_STATIC,12,23,70,8
    COMBOBOX        IDC_LINES,85,21,120,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Thickness:",IDC_STATIC,12,39,70,8
    EDITTEXT        IDC_LINE_THICKNESS,85,37,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px at 100% scaling (1-4)",IDC_STATIC,117,39,176,8
    LTEXT           "Colour:",IDC_STATIC,12,55,70,8
    CONTROL         "Text colour at",IDC_LINE_FOLLOW,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,85,54,60,10
    CONTROL         "Custom colour",IDC_LINE_CUSTOM,"Button",BS_AUTORADIOBUTTON,85,70,60,10
    EDITTEXT        IDC_LINE_OPACITY,147,53,24,12,ES_AUTOHSCROLL | ES_NUMBER | WS_GROUP
    LTEXT           "% opacity (10-100)",IDC_STATIC,175,55,118,8
    CONTROL         "",IDC_LINE_SWATCH,"Button",BS_OWNERDRAW | WS_TABSTOP | WS_GROUP,147,69,24,12
    EDITTEXT        IDC_LINE_HEX,175,69,36,12,ES_AUTOHSCROLL | ES_UPPERCASE

    LTEXT           "Rows",IDC_STATIC,7,93,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,103,286,1
    LTEXT           "Row padding:",IDC_STATIC,12,112,70,8
    EDITTEXT        IDC_ROW_PADDING,85,110,28,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px above and below the name (0-12)",IDC_STATIC,117,112,176,8
    LTEXT           "File extensions:",IDC_STATIC,12,128,70,8
    COMBOBOX        IDC_EXTENSIONS,85,126,120,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "File and folder icons",IDC_SHOW_ICONS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,85,143,92,10
    LTEXT           "Icon size (12-24):",IDC_STATIC,180,144,74,8
    EDITTEXT        IDC_ICON_SIZE,256,142,20,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",IDC_STATIC,279,144,14,8
    CONTROL         "Star favourite folders",IDC_MARK_FAVOURITES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,85,157,92,10
    LTEXT           "Star && play size (8-16):",IDC_STATIC,180,158,74,8
    EDITTEXT        IDC_MARK_SIZE,256,156,20,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",IDC_STATIC,279,158,14,8
    CONTROL         "Mark the playing track",IDC_MARK_PLAYING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,85,171,92,10
    CONTROL         "Follow the playing track",IDC_FOLLOW_PLAYING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,180,171,113,10

    LTEXT           "Sorting",IDC_STATIC,7,188,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,198,286,1
    LTEXT           "Sort by:",IDC_STATIC,12,207,70,8
    COMBOBOX        IDC_SORT_FIELD,85,205,80,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Folders first",IDC_FOLDERS_FIRST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,171,206,57,10
    CONTROL         "Reverse order",IDC_SORT_REVERSE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,231,206,62,10
END

IDD_TAB_VIEW DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Tooltips",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Show:",IDC_STATIC,12,23,70,8
    COMBOBOX        IDC_TOOLTIPS,85,21,140,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "When the mouse rests on a row. A cut-off name is shown in place, over the row.",IDC_STATIC,85,37,208,16

    LTEXT           "Rows",IDC_STATIC,7,65,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,75,286,1
    CONTROL         "Highlight the row under the mouse",IDC_HOVER_HIGHLIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,82,281,10
    CONTROL         "Shade every other row",IDC_ZEBRA,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,96,281,10
    CONTROL         "Transparent background (show what is behind the panel)",IDC_TRANSPARENT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,110,281,10

    LTEXT           "Status bar",IDC_STATIC,7,128,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,138,286,1
    CONTROL         "Show a status bar below the tree",IDC_SHOW_STATUS_BAR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,145,281,10
    LTEXT           "Counts and sizes of the selected items, or of the focused folder's contents.",IDC_STATIC,24,158,269,8
    CONTROL         "Show performance counters when the mouse rests on it",IDC_STATUS_COUNTERS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,24,171,269,10
END

IDD_TAB_FILTER DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Files",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Show files:",IDC_STATIC,12,23,70,8
    COMBOBOX        IDC_FILES,85,21,120,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Show hidden files and folders",IDC_SHOW_HIDDEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,85,39,208,10
    CONTROL         "Show system files and folders",IDC_SHOW_SYSTEM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,85,53,208,10

    LTEXT           "Exceptions",IDC_STATIC,7,75,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,85,286,1
    LTEXT           "Always show:",IDC_STATIC,12,94,70,8
    EDITTEXT        IDC_ALWAYS_SHOW,85,92,208,12,ES_AUTOHSCROLL
    LTEXT           "Extensions listed even when only playable files are shown, for example: cue; log",IDC_STATIC,85,107,208,16
    LTEXT           "Never show:",IDC_STATIC,12,128,70,8
    EDITTEXT        IDC_NEVER_SHOW,85,126,208,12,ES_AUTOHSCROLL
    LTEXT           "Extensions that are never listed.",IDC_STATIC,85,141,208,8

    LTEXT           "Hide by name",IDC_STATIC,7,161,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,171,286,1
    LTEXT           "Patterns:",IDC_STATIC,12,180,70,8
    EDITTEXT        IDC_HIDE_PATTERNS,85,178,208,12,ES_AUTOHSCROLL
    LTEXT           "Hides files and folders whose whole name matches. * stands for any characters, ? for one. Separate patterns with semicolons, for example: *.tmp; Thumbs.db; @eaDir",IDC_STATIC,85,193,208,24
END

IDD_TAB_ACTIONS DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Clicks and keys",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "On a folder",IDC_STATIC,85,21,102,8
    LTEXT           "On a file",IDC_STATIC,191,21,102,8
    LTEXT           "Single click:",IDC_STATIC,12,34,70,8
    COMBOBOX        1050,85,32,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1051,191,32,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Double click:",IDC_STATIC,12,50,70,8
    COMBOBOX        1052,85,48,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1053,191,48,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Middle click:",IDC_STATIC,12,66,70,8
    COMBOBOX        1054,85,64,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1055,191,64,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Enter key:",IDC_STATIC,12,82,70,8
    COMBOBOX        1056,85,80,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        1057,191,80,102,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "A single click always selects; its action runs as well. With Enter or a middle click, hold Shift to flip ""include subfolders"", Ctrl to use the active playlist.",IDC_STATIC,85,97,208,24
END

IDD_TAB_MENU DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Context menu",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Items in the order they appear:",IDC_STATIC,12,21,226,8
    LISTBOX         IDC_MENU_LIST,12,32,226,140,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Move up",IDC_MENU_UP,243,32,50,14
    PUSHBUTTON      "Move down",IDC_MENU_DOWN,243,48,50,14
    CONTROL         "Show this item in the menu",IDC_MENU_SHOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,177,226,10
    LTEXT           "Separators are added between groups automatically. Undo only appears when there is something to undo.",IDC_STATIC,12,191,226,16
END

IDD_TAB_FOLDERS DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Hidden folders",IDC_STATIC,7,4,286,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,7,14,286,1
    LTEXT           "Folders never listed (drives and favourites always are). Variables like %WINDIR% work, and ? stands for any drive letter.",IDC_STATIC,12,21,281,16
    LISTBOX         IDC_HIDDEN_LIST,12,41,216,112,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Add...",IDC_HIDDEN_ADD,233,41,60,14
    PUSHBUTTON      "Remove",IDC_HIDDEN_REMOVE,233,57,60,14
    PUSHBUTTON      "Restore defaults",IDC_HIDDEN_DEFAULTS,233,77,60,14
    LTEXT           "Right-click a folder in the tree and pick Hide this folder to add it.",IDC_STATIC,12,157,281,8
END

IDD_TAB_FAVOURITES DIALOGEX 0, 0, 300, 222
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Favourites",IDC_STATIC,7,4,286,8
